# Copy this file to ".env" and fill in your values. Never commit .env to GitHub.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# When testing from phones on your Wi-Fi, add your PC's IP, e.g. 192.168.1.50
# DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.1.50:8000

# The Blue Alliance "Read API Key" (thebluealliance.com > Account > Read API Keys)
TBA_API_KEY=

# Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Season shown by default on team dashboards
DEFAULT_SEASON=2026

# AI assistant: "stub" (built-in rules) or "ollama" (local model, Phase 2)
AI_PROVIDER=stub
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
